{
  "name": "psa-logbook-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config=playwright.pwa.config.ts",
    "format": "prettier --write src tests *.ts *.json index.html docs README.md"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^5.1.3",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "dexie": "^4.3.0",
    "exceljs": "^4.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuid": "^13.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
